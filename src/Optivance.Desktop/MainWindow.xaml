<Window x:Class="Optivance.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OPTIVANCE" Height="780" Width="1320" MinHeight="620" MinWidth="980"
        Background="#10131A" Foreground="#EDF2F8" WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="72" />
      <RowDefinition Height="*" />
      <RowDefinition Height="34" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#151A23" BorderBrush="#252D39" BorderThickness="0,0,0,1">
      <Grid Margin="26,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="OPTIVANCE" FontSize="18" FontWeight="Bold" />
          <TextBlock Text="STOCKAGE · SYSTÈME · PERFORMANCE" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="1,3,0,0" />
        </StackPanel>
        <Border Grid.Column="1" Background="#202A32" BorderBrush="#2B5144" BorderThickness="1" CornerRadius="12" Padding="11,5" VerticalAlignment="Center">
          <TextBlock Text="PROTOTYPE LOCAL  ·  V0.2" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
        </Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#141922" BorderBrush="#252D39" BorderThickness="0,0,1,0">
        <DockPanel Margin="14,20">
          <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="ESPACE DE TRAVAIL" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="10,4,0,14" />
            <Button x:Name="StorageNavigation" Content="▦   Storage" Tag="Storage" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,2" />
            <Button Content="◷   Monitoring" Tag="Monitoring" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,2" />
            <Button Content="⌁   Cleaning" Tag="Cleaning" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,2" />
            <Button Content="↗   Optimization" Tag="Optimization" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,2" />
            <Button Content="◷   History" Tag="History" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,2" />
            <Button Content="⚙   Settings" Tag="Settings" Click="Navigation_Click" HorizontalContentAlignment="Left" Margin="0,2" />
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Margin="9,0,8,4">
            <TextBlock Text="VERSION PROTOTYPE" FontSize="9" Foreground="{StaticResource MutedTextBrush}" />
            <TextBlock Text="V0.2 · analyse classique" FontSize="11" Margin="0,5,0,0" />
          </StackPanel>
        </DockPanel>
      </Border>
      <ContentControl x:Name="PageHost" Grid.Column="1" />
    </Grid>
    <Border Grid.Row="2" Background="#171B24" BorderBrush="#252D39" BorderThickness="0,1,0,0">
      <Grid Margin="20,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="GlobalStatus" Text="Prêt · aucune analyse en cours" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
        <TextBlock Grid.Column="1" Text="Moteur local · sans élévation au démarrage" VerticalAlignment="Center" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
      </Grid>
    </Border>
  </Grid>
</Window>
