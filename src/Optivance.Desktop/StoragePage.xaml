<UserControl x:Class="Optivance.Desktop.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Optivance.Desktop"
             Background="{StaticResource WindowBrush}">
  <Grid Margin="26,20,26,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="68" />
      <RowDefinition Height="62" />
      <RowDefinition Height="34" />
      <RowDefinition Height="170" />
      <RowDefinition Height="26" />
      <RowDefinition Height="*" MinHeight="145" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="44" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="0,0,0,10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="ANALYSE AVANCÉE DU STOCKAGE" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
        <TextBlock Text="Storage" FontSize="29" FontWeight="SemiBold" Margin="0,3,0,1" />
        <TextBlock Text="Explorez le contenu et repérez les éléments les plus volumineux." FontSize="11" Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>
      <Border Grid.Column="1" Background="#202A32" BorderBrush="#2B5144" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Top">
        <TextBlock Text="V0.2 · SCAN CLASSIQUE" FontSize="9" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,9">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Margin="0,0,9,0">
          <TextBlock Text="VOLUME PRÊT" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,4" />
          <ComboBox x:Name="DriveSelector" Height="34" VerticalContentAlignment="Center" SelectionChanged="DriveSelector_SelectionChanged" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,9,0">
          <TextBlock Text="DOSSIER OU VOLUME À ANALYSER" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="2,0,0,4" />
          <TextBox x:Name="TargetPath" Height="34" VerticalContentAlignment="Center" Padding="9,6" />
        </StackPanel>
        <Button x:Name="BrowseButton" Grid.Column="2" Content="Parcourir…" Click="Browse_Click" Margin="0,16,8,0" Padding="11,7" />
        <Button x:Name="AnalyzeButton" Grid.Column="3" Content="Analyser" Click="Analyze_Click" Background="#235240" BorderBrush="#35765B" FontWeight="SemiBold" Margin="0,16,0,0" Padding="18,7" />
      </Grid>
    </Border>

    <Grid Grid.Row="2" Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#171B24" BorderBrush="#252D39" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="ÉLÉMENTS ANALYSÉS" FontSize="9" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="FilesSummary" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
      <Border Grid.Column="1" Background="#171B24" BorderBrush="#252D39" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,8,0"><StackPanel><TextBlock Text="TAILLE LOGIQUE UNIQUE" FontSize="9" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="LogicalSummary" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
      <Border Grid.Column="2" Background="#171B24" BorderBrush="#252D39" BorderThickness="1" CornerRadius="8" Padding="12,8"><StackPanel><TextBlock Text="TAILLE ALLOUÉE UNIQUE" FontSize="9" Foreground="{StaticResource MutedTextBrush}" /><TextBlock x:Name="AllocatedSummary" Text="—" FontSize="18" FontWeight="SemiBold" Margin="0,3,0,0" /></StackPanel></Border>
    </Grid>

    <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,0,0,5">
      <Button x:Name="BackButton" DockPanel.Dock="Left" Content="‹  Parent" Click="Back_Click" IsEnabled="False" Padding="10,4" Margin="0,0,9,0" />
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" VerticalAlignment="Center" />
      </ScrollViewer>
    </DockPanel>

    <Border Grid.Row="4" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
      <Grid>
        <local:TreemapView x:Name="Treemap" />
        <Border x:Name="TreemapEmptyState" Background="#CC10131A" Visibility="Visible" IsHitTestVisible="False">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock x:Name="TreemapEmptyTitle" Text="Aucune analyse" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="TreemapEmptyDescription" Text="Choisissez une cible et lancez une analyse pour construire la treemap." FontSize="10" Foreground="{StaticResource MutedTextBrush}" TextAlignment="Center" Margin="0,5,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <DockPanel Grid.Row="5" Margin="0,2,0,5">
      <TextBlock DockPanel.Dock="Left" Text="Treemap · surface proportionnelle à la taille logique unique · les alias de hardlinks ne sont pas recomptés" FontSize="9" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
      <ItemsControl DockPanel.Dock="Right">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.Items>
          <Border Margin="5,0,3,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#4B6F9C"/><TextBlock Text="Dossiers" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
          <Border Margin="5,0,3,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#479570"/><TextBlock Text="Documents" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
          <Border Margin="5,0,3,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#4291C0"/><TextBlock Text="Images" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
          <Border Margin="5,0,3,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#8367B9"/><TextBlock Text="Vidéos" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
          <Border Margin="5,0,3,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#BF7746"/><TextBlock Text="Audio" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
          <Border Margin="5,0,3,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#C7A34C"/><TextBlock Text="Archives" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
          <Border Margin="5,0,3,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#BA5265"/><TextBlock Text="Applications" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
          <Border Margin="5,0,3,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#359191"/><TextBlock Text="Code" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
          <Border Margin="5,0,0,0" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="#515F73"/><TextBlock Text="Autres" FontSize="9" Foreground="{StaticResource MutedTextBrush}" Margin="4,0,0,0" /></StackPanel></Border>
        </ItemsControl.Items>
      </ItemsControl>
    </DockPanel>

    <Grid Grid.Row="6" Margin="0,0,0,4">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,5">
        <TextBlock Text="Éléments du dossier" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock x:Name="ResultCount" Text="Aucune analyse" FontSize="10" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="10,1,0,0" />
        <TextBlock x:Name="DirectoryPath" Text="" FontSize="9" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
      </DockPanel>
      <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" SelectionMode="Single" SelectionChanged="ResultsGrid_SelectionChanged" MouseDoubleClick="ResultsGrid_MouseDoubleClick" PreviewMouseRightButtonDown="ResultsGrid_PreviewMouseRightButtonDown" MinHeight="145">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Type" Binding="{Binding Kind}" SortMemberPath="Kind" Width="84" />
          <DataGridTextColumn Header="Nom" Binding="{Binding Name}" SortMemberPath="Name" Width="190" />
          <DataGridTextColumn Header="Taille logique" Binding="{Binding LogicalText}" SortMemberPath="LogicalBytes" Width="118" />
          <DataGridTextColumn Header="Taille allouée" Binding="{Binding AllocatedText}" SortMemberPath="AllocatedBytes" Width="124" />
          <DataGridTextColumn Header="Hardlink" Binding="{Binding HardLinkText}" SortMemberPath="IsHardLinkDuplicate" Width="126" />
          <DataGridTextColumn Header="Chemin" Binding="{Binding Path}" SortMemberPath="Path" Width="*" />
        </DataGrid.Columns>
      </DataGrid>
    </Grid>

    <Expander Grid.Row="7" x:Name="WarningsExpander" Header="Avertissements d’analyse · 0" IsExpanded="False" Foreground="{StaticResource TextBrush}" Margin="0,1,0,4">
      <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8" MaxHeight="100">
        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="WarningsList" /></ScrollViewer>
      </Border>
    </Expander>

    <Border Grid.Row="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,5">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="ScanStatus" Text="Prêt. Analyse classique sans élévation; MFT non utilisée." FontSize="10" />
          <ProgressBar x:Name="ScanProgress" Height="3" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" />
        </StackPanel>
        <Button x:Name="CancelButton" Grid.Column="1" Content="Annuler" Click="Cancel_Click" IsEnabled="False" Padding="12,5" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
