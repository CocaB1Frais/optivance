<UserControl x:Class="Optivance.Desktop.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:storage="clr-namespace:Optivance.Desktop.Storage"
             Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI" FontSize="12.5">
  <UserControl.Resources>
    <DataTemplate x:Key="DriveTemplate" DataType="{x:Type storage:DriveItem}">
      <StackPanel Orientation="Horizontal" Margin="0,2">
        <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="18" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
        <StackPanel>
          <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
          <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
            <Border Width="120" Height="5" CornerRadius="2.5" Background="#2A3240" VerticalAlignment="Center">
              <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="2.5" Background="{StaticResource AccentBrush}" />
            </Border>
            <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="8,0,0,0" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid Margin="18,14,18,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="3*" MinHeight="160" />
      <RowDefinition Height="8" />
      <RowDefinition Height="2*" MinHeight="120" />
    </Grid.RowDefinitions>

    <!-- En-tête : choix de la cible et actions. -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center" Margin="0,0,22,0">
        <TextBlock Text="Stockage" FontSize="22" FontWeight="SemiBold" />
        <TextBlock Text="Ce qui occupe vos disques, fichier par fichier" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="1,2,0,0" />
      </StackPanel>
      <ComboBox x:Name="DriveSelector" Grid.Column="1" MinWidth="330" Height="50" VerticalAlignment="Center"
                ItemTemplate="{StaticResource DriveTemplate}" ItemContainerStyle="{StaticResource DarkComboBoxItem}" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
        <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Click="ScanButton_Click" ToolTip="Analyse rapide par la MFT (autorisation Windows à chaque analyse) — F5">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
            <TextBlock Text="Analyser" Foreground="#F4FFFA" FontWeight="SemiBold" />
          </StackPanel>
        </Button>
        <Button x:Name="FolderButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="FolderButton_Click" ToolTip="Analyser un dossier précis (analyse standard)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8DA;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
            <TextBlock Text="Dossier…" />
          </StackPanel>
        </Button>
        <Button x:Name="EnableFastButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="EnableFastButton_Click" Visibility="Collapsed"
                ToolTip="Demander l’autorisation administrateur une fois pour toute la session (lecture directe de la MFT)">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE945;" Style="{StaticResource Icon}" Foreground="#F2C14E" Margin="0,0,8,0" />
            <TextBlock Text="Activer l’analyse rapide" />
          </StackPanel>
        </Button>
        <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="CancelButton_Click" Visibility="Collapsed">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE711;" Style="{StaticResource Icon}" Margin="0,0,8,0" />
            <TextBlock Text="Annuler" />
          </StackPanel>
        </Button>
      </StackPanel>
      <Border x:Name="MethodBadge" Grid.Column="4" CornerRadius="12" Padding="12,5" VerticalAlignment="Center" Background="#1C2B27" BorderBrush="#2E5C4B" BorderThickness="1" Visibility="Collapsed">
        <StackPanel Orientation="Horizontal">
          <TextBlock x:Name="MethodIcon" Text="&#xE945;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="0,0,7,0" />
          <TextBlock x:Name="MethodText" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
        </StackPanel>
      </Border>
    </Grid>

    <!-- Bandeau d'information (repli, avertissements). -->
    <Border x:Name="NoticeBar" Grid.Row="1" Margin="0,12,0,0" CornerRadius="8" Background="#2A2416" BorderBrush="#5C4A1E" BorderThickness="1" Padding="12,8" Visibility="Collapsed">
      <DockPanel>
        <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" Foreground="#F2C14E" Margin="0,0,10,0" />
        <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="Masquer" Click="HideNotice_Click" />
        <TextBlock x:Name="NoticeText" TextWrapping="Wrap" Foreground="#F3E3B8" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- Synthèse. -->
    <UniformGrid x:Name="SummaryCards" Grid.Row="2" Rows="1" Margin="0,12,0,12" Visibility="Collapsed">
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="ESPACE DU DISQUE" Style="{StaticResource Caption}" />
          <TextBlock x:Name="DiskUsedText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
          <Border Height="6" CornerRadius="3" Background="#2A3240" Margin="0,7,0,0">
            <Border x:Name="DiskUsedBar" HorizontalAlignment="Left" CornerRadius="3" Background="{StaticResource AccentBrush}" />
          </Border>
          <TextBlock x:Name="DiskDetailText" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="TAILLE ANALYSÉE" Style="{StaticResource Caption}" />
          <TextBlock x:Name="TotalText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
          <TextBlock x:Name="TotalDetailText" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="FICHIERS" Style="{StaticResource Caption}" />
          <TextBlock x:Name="FilesText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
          <TextBlock x:Name="FilesDetailText" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="DOSSIERS" Style="{StaticResource Caption}" />
          <TextBlock x:Name="FoldersText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
          <TextBlock x:Name="FoldersDetailText" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
      <Border Style="{StaticResource Card}" Padding="14,10">
        <StackPanel>
          <TextBlock Text="ANALYSE" Style="{StaticResource Caption}" />
          <TextBlock x:Name="DurationText" FontSize="19" FontWeight="SemiBold" Margin="0,4,0,0" />
          <TextBlock x:Name="StateText" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" Margin="0,5,0,0" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- Zone principale : arborescence / fichiers + extensions. -->
    <Grid x:Name="MainArea" Grid.Row="3" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="420" />
        <ColumnDefinition Width="8" />
        <ColumnDefinition Width="370" MinWidth="250" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <TabControl x:Name="ViewTabs" SelectionChanged="ViewTabs_SelectionChanged">
          <TabControl.Tag>
            <Border CornerRadius="6" Background="#141922" BorderBrush="#2A3341" BorderThickness="1" Width="260" Height="28">
              <DockPanel>
                <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Foreground="{StaticResource MutedTextBrush}" Margin="9,0,6,0" FontSize="11" />
                <Button x:Name="ClearSearchButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="9" Padding="7,2" Click="ClearSearch_Click" Visibility="Collapsed" />
                <Grid>
                  <TextBlock x:Name="SearchHint" Text="Rechercher un fichier…" Foreground="#6C7889" VerticalAlignment="Center" IsHitTestVisible="False" />
                  <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource AccentBrush}" VerticalContentAlignment="Center" Padding="0" TextChanged="SearchBox_TextChanged" />
                </Grid>
              </DockPanel>
            </Border>
          </TabControl.Tag>
          <TabItem Header="Arborescence">
            <ListView x:Name="TreeList" Style="{StaticResource DataList}" MouseDoubleClick="TreeList_MouseDoubleClick"
                      PreviewKeyDown="TreeList_PreviewKeyDown" SelectionChanged="TreeList_SelectionChanged" ContextMenuOpening="List_ContextMenuOpening">
              <ListView.ContextMenu><ContextMenu /></ListView.ContextMenu>
              <ListView.View>
                <GridView AllowsColumnReorder="False">
                  <GridViewColumn Width="380">
                    <GridViewColumnHeader Content="Nom" Tag="Name" Click="TreeHeader_Click" />
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type storage:TreeRow}">
                        <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTip}">
                          <Border Width="{Binding Indent}" />
                          <Border Width="18" Background="Transparent" MouseLeftButtonDown="Expander_MouseLeftButtonDown" Cursor="Hand">
                            <TextBlock Text="{Binding Expander}" Style="{StaticResource Icon}" FontSize="9" Foreground="#8C99AC" HorizontalAlignment="Center" />
                          </Border>
                          <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding GlyphBrush}" Margin="2,0,8,0" />
                          <TextBlock Text="{Binding Name}" Opacity="{Binding NameOpacity}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="128">
                    <GridViewColumnHeader Content="% du parent" Tag="Size" Click="TreeHeader_Click" />
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type storage:TreeRow}">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="64" Height="10" CornerRadius="2" Background="#232B37" VerticalAlignment="Center">
                            <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="2" Background="#4F9E80" />
                          </Border>
                          <TextBlock Text="{Binding PercentText}" Margin="8,0,0,0" FontSize="11.5" Foreground="#B9C4D3" VerticalAlignment="Center" />
                        </StackPanel>
                      </DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="96">
                    <GridViewColumnHeader Content="Taille" Tag="Size" Click="TreeHeader_Click" />
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type storage:TreeRow}"><TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" /></DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="96">
                    <GridViewColumnHeader Content="Alloué" Tag="Allocated" Click="TreeHeader_Click" />
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type storage:TreeRow}"><TextBlock Text="{Binding AllocatedText}" Foreground="#B9C4D3" /></DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="84">
                    <GridViewColumnHeader Content="Éléments" Tag="Items" Click="TreeHeader_Click" />
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type storage:TreeRow}"><TextBlock Text="{Binding ItemsText}" Foreground="#B9C4D3" /></DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="80">
                    <GridViewColumnHeader Content="Fichiers" Tag="Items" Click="TreeHeader_Click" />
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type storage:TreeRow}"><TextBlock Text="{Binding FilesText}" Foreground="#B9C4D3" /></DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="80">
                    <GridViewColumnHeader Content="Dossiers" Tag="Items" Click="TreeHeader_Click" />
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type storage:TreeRow}"><TextBlock Text="{Binding FoldersText}" Foreground="#B9C4D3" /></DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Width="128">
                    <GridViewColumnHeader Content="Modifié" Tag="Modified" Click="TreeHeader_Click" />
                    <GridViewColumn.CellTemplate>
                      <DataTemplate DataType="{x:Type storage:TreeRow}"><TextBlock Text="{Binding ModifiedText}" Foreground="#B9C4D3" /></DataTemplate>
                    </GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </TabItem>
          <TabItem x:Name="FilesTab">
            <TabItem.Header>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Fichiers" />
                <TextBlock x:Name="FilesTabCount" Foreground="{StaticResource MutedTextBrush}" Margin="6,0,0,0" FontWeight="Normal" />
              </StackPanel>
            </TabItem.Header>
            <DockPanel>
              <Border x:Name="FilterChip" DockPanel.Dock="Top" HorizontalAlignment="Left" Margin="10,8,0,2" CornerRadius="11" Padding="10,3,4,3" Background="#22303A" BorderBrush="#35506A" BorderThickness="1" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="FilterSwatch" Width="10" Height="10" CornerRadius="2" VerticalAlignment="Center" Margin="0,0,7,0" />
                  <TextBlock x:Name="FilterText" VerticalAlignment="Center" FontSize="11.5" />
                  <Button Style="{StaticResource ToolButton}" Content="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="8" Padding="6,2" Margin="4,0,0,0" Click="ClearExtensionFilter_Click" ToolTip="Retirer le filtre" />
                </StackPanel>
              </Border>
              <ListView x:Name="FileList" Style="{StaticResource DataList}" MouseDoubleClick="FileList_MouseDoubleClick"
                        PreviewKeyDown="FileList_PreviewKeyDown" SelectionChanged="FileList_SelectionChanged" ContextMenuOpening="List_ContextMenuOpening">
                <ListView.ContextMenu><ContextMenu /></ListView.ContextMenu>
                <ListView.View>
                  <GridView AllowsColumnReorder="False">
                    <GridViewColumn Header="Nom" Width="300">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type storage:FileRow}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Icon}" FontSize="14" Foreground="{Binding GlyphBrush}" Margin="4,0,8,0" />
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Taille" Width="96">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type storage:FileRow}"><TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" /></DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Alloué" Width="96">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type storage:FileRow}"><TextBlock Text="{Binding AllocatedText}" Foreground="#B9C4D3" /></DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Modifié" Width="128">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type storage:FileRow}"><TextBlock Text="{Binding ModifiedText}" Foreground="#B9C4D3" /></DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Dossier" Width="460">
                      <GridViewColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type storage:FileRow}"><TextBlock Text="{Binding Folder}" Foreground="#8E9AAC" TextTrimming="CharacterEllipsis" /></DataTemplate>
                      </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                  </GridView>
                </ListView.View>
              </ListView>
            </DockPanel>
          </TabItem>
        </TabControl>
      </Border>
      <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />
      <Border Grid.Column="2" Style="{StaticResource Card}">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="#262F3C" BorderThickness="0,0,0,1" Padding="14,10">
            <DockPanel>
              <TextBlock x:Name="ExtensionCount" DockPanel.Dock="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11" VerticalAlignment="Center" />
              <TextBlock Text="Types de fichiers" FontWeight="SemiBold" />
            </DockPanel>
          </Border>
          <ListView x:Name="ExtensionList" Style="{StaticResource DataList}" SelectionChanged="ExtensionList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.View>
              <GridView AllowsColumnReorder="False">
                <GridViewColumn Header="Extension" Width="150">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type storage:ExtensionRow}">
                      <StackPanel Orientation="Horizontal" ToolTip="{Binding Description}">
                        <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Swatch}" Margin="4,0,9,0" VerticalAlignment="Center" />
                        <StackPanel>
                          <TextBlock Text="{Binding Extension}" FontWeight="SemiBold" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Taille" Width="78">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type storage:ExtensionRow}"><TextBlock Text="{Binding SizeText}" /></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="%" Width="62">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type storage:ExtensionRow}"><TextBlock Text="{Binding PercentText}" Foreground="#B9C4D3" /></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
                <GridViewColumn Header="Fichiers" Width="66">
                  <GridViewColumn.CellTemplate>
                    <DataTemplate DataType="{x:Type storage:ExtensionRow}"><TextBlock Text="{Binding FilesText}" Foreground="#B9C4D3" /></DataTemplate>
                  </GridViewColumn.CellTemplate>
                </GridViewColumn>
              </GridView>
            </ListView.View>
          </ListView>
        </DockPanel>
      </Border>
    </Grid>

    <GridSplitter x:Name="TreemapSplitter" Grid.Row="4" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />

    <!-- Treemap. -->
    <Border x:Name="TreemapCard" Grid.Row="5" Style="{StaticResource Card}" Visibility="Collapsed">
      <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="#262F3C" BorderThickness="0,0,0,1" Padding="10,6">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button x:Name="TreemapUpButton" Style="{StaticResource ToolButton}" Click="TreemapUp_Click" ToolTip="Remonter d’un niveau">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74A;" Style="{StaticResource Icon}" Margin="0,0,6,0" /><TextBlock Text="Remonter" /></StackPanel>
              </Button>
              <Button Style="{StaticResource ToolButton}" Click="TreemapReset_Click" ToolTip="Afficher toute l’analyse">
                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8A9;" Style="{StaticResource Icon}" Margin="0,0,6,0" /><TextBlock Text="Vue complète" /></StackPanel>
              </Button>
            </StackPanel>
            <TextBlock Text="&#xF0E2;" Style="{StaticResource Icon}" Foreground="{StaticResource AccentBrush}" Margin="4,0,8,0" />
            <TextBlock x:Name="TreemapTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="420" />
            <TextBlock x:Name="TreemapHover" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis" />
          </DockPanel>
        </Border>
        <storage:CushionTreemapView x:Name="Treemap" Margin="6" />
      </DockPanel>
    </Border>

    <!-- Accueil (avant la première analyse). -->
    <Border x:Name="WelcomePanel" Grid.Row="2" Grid.RowSpan="4" Style="{StaticResource Card}" Margin="0,12,0,0">
      <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
          <Border Width="74" Height="74" CornerRadius="37" Background="#1C2B27" HorizontalAlignment="Center">
            <TextBlock Text="&#xEDA2;" Style="{StaticResource Icon}" FontSize="32" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
          </Border>
          <TextBlock Text="Voyez ce qui remplit vos disques" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,18,0,0" />
          <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" FontSize="13"
                     Text="Choisissez un disque puis lancez l’analyse. Sur un disque NTFS, l’analyse rapide lit directement la table des fichiers (MFT) : Windows vous demandera votre autorisation à chaque fois. Sans autorisation, l’analyse standard prend le relais." />
          <Button Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,22,0,0" Padding="22,10" Click="ScanButton_Click">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE721;" Style="{StaticResource Icon}" Margin="0,0,9,0" />
              <TextBlock Text="Analyser le disque sélectionné" Foreground="#F4FFFA" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Analyse en cours. -->
    <Border x:Name="ScanOverlay" Grid.Row="2" Grid.RowSpan="4" Margin="0,12,0,0" CornerRadius="10" Background="#F2121620" BorderBrush="#262F3C" BorderThickness="1" Visibility="Collapsed">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
        <TextBlock x:Name="OverlayTitle" Text="Analyse en cours…" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <ProgressBar IsIndeterminate="True" Height="4" Margin="0,16,0,0" BorderThickness="0" />
        <TextBlock x:Name="OverlayCounters" HorizontalAlignment="Center" Margin="0,14,0,0" FontSize="14" />
        <TextBlock x:Name="OverlayHint" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
