<UserControl x:Class="Optivance.Desktop.MonitoringPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#10131A">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="42,38,42,36">
      <TextBlock Text="MONITORING" FontSize="10" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
      <TextBlock Text="Monitoring" FontSize="31" FontWeight="SemiBold" Margin="0,9,0,4" />
      <TextBlock Text="État des ressources et capteurs système." FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
      <Border Background="#171B24" BorderBrush="#303B4B" BorderThickness="1" CornerRadius="12" Padding="22" Margin="0,28,0,0">
        <StackPanel>
          <TextBlock Text="Sources de mesures non initialisées" FontSize="16" FontWeight="SemiBold" />
          <TextBlock Text="V0.1 n’interroge aucun capteur. CPU, mémoire, disques, GPU, températures, fréquences, alimentation et réseau apparaissent comme indisponibles jusqu’aux validations des sources de mesure." TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" Margin="0,10,0,0" />
          <TextBlock Text="Aucune valeur simulée ou inventée n’est affichée." Foreground="{StaticResource AccentBrush}" Margin="0,13,0,0" FontSize="12" />
        </StackPanel>
      </Border>
      <UniformGrid Columns="3" Margin="0,18,0,0">
        <Border Background="#171B24" BorderBrush="#252D39" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,10,10"><StackPanel><TextBlock Text="CPU" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="Indisponible" FontSize="17" Margin="0,7,0,0" /></StackPanel></Border>
        <Border Background="#171B24" BorderBrush="#252D39" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,10,10"><StackPanel><TextBlock Text="Mémoire" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="Indisponible" FontSize="17" Margin="0,7,0,0" /></StackPanel></Border>
        <Border Background="#171B24" BorderBrush="#252D39" BorderThickness="1" CornerRadius="10" Padding="17" Margin="0,0,0,10"><StackPanel><TextBlock Text="GPU / capteurs" Foreground="{StaticResource MutedTextBrush}" /><TextBlock Text="Indisponible" FontSize="17" Margin="0,7,0,0" /></StackPanel></Border>
      </UniformGrid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
