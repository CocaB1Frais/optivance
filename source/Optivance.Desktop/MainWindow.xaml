<Window x:Class="Optivance.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OPTIVANCE" Height="820" Width="1360" MinHeight="620" MinWidth="980"
        Icon="pack://application:,,,/Assets/icon.png"
        Background="#10131A" Foreground="#EDF2F8" WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Closing="Window_Closing" StateChanged="Window_StateChanged">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <FontFamily x:Key="NavIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <Style x:Key="NavButton" TargetType="Button">
      <Setter Property="Foreground" Value="#B4BFCE" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,10">
              <Grid>
                <Border x:Name="Marker" Width="3" HorizontalAlignment="Left" Margin="-12,2,0,2" CornerRadius="2" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                <ContentPresenter />
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#1D2430" /><Setter Property="Foreground" Value="#EDF2F8" /></Trigger>
              <Trigger Property="Tag" Value="Selected"><Setter TargetName="Chrome" Property="Background" Value="#1C2E2A" /><Setter TargetName="Marker" Property="Visibility" Value="Visible" /><Setter Property="Foreground" Value="#EDF2F8" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Foreground" Value="#B4BFCE" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Setter Property="FontFamily" Value="{StaticResource NavIconFont}" />
      <Setter Property="FontSize" Value="10" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#232B38" /><Setter Property="Foreground" Value="#EDF2F8" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#2C3646" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseCaptionButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#C42B1C" /><Setter Property="Foreground" Value="White" /></Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowFrame">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="34" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Boutons de fenêtre posés sur l'application (pas de bande ni de trait) ; icônes dessinées. -->
    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Panel.ZIndex="10">
      <Button Style="{StaticResource CaptionButton}" ToolTip="Réduire" Click="Minimize_Click">
        <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" SnapsToDevicePixels="True" />
      </Button>
      <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="Agrandir" Click="Maximize_Click">
        <Path x:Name="MaximizeGlyph" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" SnapsToDevicePixels="True" />
      </Button>
      <Button Style="{StaticResource CloseCaptionButton}" ToolTip="Fermer" Click="Close_Click">
        <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" />
      </Button>
    </StackPanel>
    <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Background="#12161E" BorderBrush="#222A36" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,18,14,14">
        <Image DockPanel.Dock="Top" Source="pack://application:,,,/Assets/logo.png" Height="38" HorizontalAlignment="Left" Margin="6,0,0,26"
               RenderOptions.BitmapScalingMode="HighQuality" />
        <StackPanel DockPanel.Dock="Bottom" Margin="6,0,0,0">
          <TextBlock x:Name="VersionText" FontSize="10.5" Foreground="#6E7A8C" />
        </StackPanel>
        <StackPanel x:Name="Navigation">
          <Button Style="{StaticResource NavButton}" x:Name="StorageNavigation" Uid="Storage" Click="Navigation_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xEDA2;" FontFamily="{StaticResource NavIconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Stockage" FontSize="13" /></StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Uid="Monitoring" Click="Navigation_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9D9;" FontFamily="{StaticResource NavIconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Monitoring" FontSize="13" /></StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Uid="Cleaning" Click="Navigation_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE894;" FontFamily="{StaticResource NavIconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Nettoyage" FontSize="13" /></StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Uid="Optimization" Click="Navigation_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE945;" FontFamily="{StaticResource NavIconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Optimisation" FontSize="13" /></StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Uid="History" Click="Navigation_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE81C;" FontFamily="{StaticResource NavIconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Historique" FontSize="13" /></StackPanel>
          </Button>
          <Button Style="{StaticResource NavButton}" Uid="Settings" Click="Navigation_Click">
            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="{StaticResource NavIconFont}" FontSize="15" Margin="0,0,12,0" VerticalAlignment="Center" /><TextBlock Text="Paramètres" FontSize="13" /></StackPanel>
          </Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1" />

    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#12161E" BorderBrush="#222A36" BorderThickness="0,1,0,0">
      <Grid Margin="18,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock x:Name="GlobalStatus" Text="Prêt" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ElevationStatus" Grid.Column="1" VerticalAlignment="Center" FontSize="10.5" Foreground="{StaticResource MutedTextBrush}" />
      </Grid>
    </Border>
  </Grid>
  </Border>
</Window>
