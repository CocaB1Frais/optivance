<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OPTIVANCE</AssemblyName>
    <RootNamespace>Optivance.Desktop</RootNamespace>
    <!-- Zone de notification (NotifyIcon) : fait partie de .NET Windows Desktop, aucune dépendance tierce. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\optivance.ico</ApplicationIcon>
    <!-- Interface en français : les traductions des autres langues de .NET (WPF, WinForms) ne sont pas embarquées. -->
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms ne sert qu'à la zone de notification : pas d'espaces de noms implicites (conflits avec WPF). -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Optivance.Core\Optivance.Core.csproj" />
    <ProjectReference Include="..\Optivance.Infrastructure\Optivance.Infrastructure.csproj" />
</ItemGroup>

</Project>
