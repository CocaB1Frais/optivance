<Project>
  <!-- Numéro de version unique d'OPTIVANCE : à modifier ici (et dans CHANGELOG.md) avant chaque publication. -->
  <PropertyGroup>
    <Version>1.1.1</Version>
    <Product>OPTIVANCE</Product>
    <Company>OPTIVANCE</Company>
    <Copyright>© 2026 OPTIVANCE. Tous droits réservés.</Copyright>
    <!-- Page des versions publiées (ouverte dans le navigateur ; l'application ne se connecte à rien). -->
    <OptivanceReleasesUrl>https://github.com/CocaB1Frais/optivance/releases</OptivanceReleasesUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="ReleasesUrl" Value="$(OptivanceReleasesUrl)" />
  </ItemGroup>
</Project>
